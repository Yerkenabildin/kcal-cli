# kcal does not load this file automatically. Export only the values you need.
# Never put a YAZIO password here; login reads it from a hidden terminal prompt.

# Local paths
# KCAL_DB_FILE=/absolute/path/to/kcal.sqlite3
# KCAL_DATA_DIR=~/.local/share/kcal
# KCAL_CONFIG_DIR=~/.config/kcal
# KCAL_STATE_DIR=~/.local/state/kcal

# OpenRouter label recognition. OPENROUTER_API_KEY is the only accepted key variable.
# OPENROUTER_API_KEY=
# KCAL_OPENROUTER_MODEL=openrouter/auto
# KCAL_OPENROUTER_API_URL=https://openrouter.ai/api/v1
# KCAL_TIMEOUT_MS=30000

# Open Food Facts
# KCAL_OFF_API_URL=https://world.openfoodfacts.org
# KCAL_OFF_USER_AGENT=kcal-cli/0.2.0 (local personal nutrition tool)

# Private YAZIO provider
# YAZIO_API_URL=https://yzapi.yazio.com
# YAZIO_USER_AGENT=YAZIO/26.30.1 (com.yazio.ios.YAZIO; build:2607271240; iOS 27.0.0) Ktor
# YAZIO_ACCEPT_LANGUAGE=nl-NL,nl;q=0.9,en;q=0.8
# YAZIO_COUNTRIES=NL
# YAZIO_LOCALES=nl_NL,en_NL
# YAZIO_CLIENT_ID=
# YAZIO_CLIENT_SECRET=
# YAZIO_TOKEN_FILE=~/.config/kcal/providers/yazio-token.json
# YAZIO_TIMEOUT_MS=30000
# YAZIO_RETRIES=2
