# Every value here is optional — the CLI ships working defaults for all of them.
# Never put the YAZIO account password in this file: `yazio login` reads it from a
# hidden TTY prompt and stores only tokens.

# API origin. Only paths under /v22/ are reachable through the client.
# YAZIO_API_URL=https://yzapi.yazio.com

# The API refuses any request whose client version it does not recognise, answering
# 403 {"error":"version_blocked"} on everything except the token exchange. Bump this
# when that happens.
# YAZIO_USER_AGENT=YAZIO/26.30.1 (com.yazio.ios.YAZIO; build:2607271240; iOS 27.0.0) Ktor

# Product search is ranked by this header, and additionally hinted by `locales`.
# YAZIO_ACCEPT_LANGUAGE=nl-NL,nl;q=0.9,en;q=0.8

# Search region. Both are normally taken from the authenticated profile; these only
# override it.
# YAZIO_COUNTRIES=NL
# YAZIO_LOCALES=nl_NL,en_NL

# The OAuth client the mobile app ships with. Identifies the app, not the user.
# YAZIO_CLIENT_ID=
# YAZIO_CLIENT_SECRET=

# YAZIO_TOKEN_FILE=~/.config/yazio-cli/token.json
# YAZIO_STATE_DIR=~/.local/state/yazio-cli
# YAZIO_TIMEOUT_MS=30000
# YAZIO_RETRIES=2
